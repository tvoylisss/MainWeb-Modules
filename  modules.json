[
    {
        "name": "TelegramNotify",
        "version": "1.0.0",
        "author": "Ivan Ivanov",
        "description": "Модуль уведомлений в Telegram о новых регистрациях",
        "php": ">=8.1",
        "hasTables": false,
        "provider": "App\\Modules\\TelegramNotify\\TelegramNotifyServiceProvider",
        "config": [
            {
                "key": "api_key",
                "label": "API ключ Telegram",
                "type": "string",
                "required": true
            },
            {
                "key": "chat_id",
                "label": "ID чата Telegram",
                "type": "string",
                "required": true
            },
            {
                "key": "enabled",
                "label": "Включить уведомления",
                "type": "boolean",
                "required": false,
                "default": true
            }
        ],
        "documentation": "https://example.com/telegramnotify/docs",
        "telegram": "@ivan_module"
    },
    {
        "name": "UserLogger",
        "version": "1.2.0",
        "author": "Olga Petrova",
        "description": "Логирует действия пользователей и события регистрации",
        "php": ">=8.0",
        "hasTables": true,
        "provider": "App\\Modules\\UserLogger\\UserLoggerServiceProvider",
        "config": [
            {
                "key": "log_level",
                "label": "Уровень логирования",
                "type": "string",
                "required": true,
                "default": "info"
            },
            {
                "key": "enabled",
                "label": "Включить логирование",
                "type": "boolean",
                "required": false,
                "default": true
            }
        ],
        "documentation": "https://example.com/userlogger/docs",
        "telegram": "@olga_module"
    },
    {
        "name": "EmailNotify",
        "version": "2.0.0",
        "author": "Sergey Ivanov",
        "description": "Модуль отправки email-уведомлений о событиях на сайте",
        "php": ">=8.1",
        "hasTables": false,
        "provider": "App\\Modules\\EmailNotify\\EmailNotifyServiceProvider",
        "config": [
            {
                "key": "smtp_host",
                "label": "SMTP сервер",
                "type": "string",
                "required": true
            },
            {
                "key": "smtp_port",
                "label": "Порт SMTP",
                "type": "integer",
                "required": true,
                "default": 587
            },
            {
                "key": "smtp_user",
                "label": "Пользователь SMTP",
                "type": "string",
                "required": true
            },
            {
                "key": "smtp_pass",
                "label": "Пароль SMTP",
                "type": "string",
                "required": true
            },
            {
                "key": "from_email",
                "label": "Email отправителя",
                "type": "string",
                "required": true
            }
        ],
        "documentation": "https://example.com/emailnotify/docs",
        "telegram": "@sergey_module"
    }
]